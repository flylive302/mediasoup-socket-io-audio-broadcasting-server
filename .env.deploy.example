# ==============================================================================
# APPLICATION CONFIGURATION (PRODUCTION DEPLOYMENT)
# ==============================================================================
# SECURITY WARNING: Do NOT commit real credentials to version control!
# Copy this file to .env.deploy and fill in your production values.
# ==============================================================================

NODE_ENV=production
PORT=3030
LOG_LEVEL=info

# ==============================================================================
# REDIS CONFIGURATION (AWS ElastiCache)
# Values come from Terraform ElastiCache module outputs
# ==============================================================================
REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
# REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=3
# REDIS_TLS=true  # Enable if using in-transit encryption

# ==============================================================================
# LARAVEL API INTEGRATION
# ==============================================================================
LARAVEL_API_URL=https://api.yourapp.com
LARAVEL_INTERNAL_KEY=your-secure-internal-key-min-32-chars

# ==============================================================================
# MEDIASOUP CONFIGURATION
# ==============================================================================
MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_ANNOUNCED_IP is auto-detected from EC2 IMDS in production
# MEDIASOUP_ANNOUNCED_IP=YOUR_EC2_PUBLIC_IP
# MEDIASOUP_NUM_WORKERS=2  # Optional: defaults to CPU count

# MediaSoup RTC Port Range
MEDIASOUP_RTC_MIN_PORT=10000
MEDIASOUP_RTC_MAX_PORT=59999

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com

# ==============================================================================
# ROOM AUTO-CLOSE
# ==============================================================================
ROOM_INACTIVITY_TIMEOUT_MS=300000      # 5 minutes default
ROOM_AUTO_CLOSE_POLL_INTERVAL_MS=30000 # 30 seconds default

# ==============================================================================
# AUDIO QUALITY SAMPLER (observability-audio-quality 01)
# ==============================================================================
# Scores are pushed by the SFU as they change, so this only affects how fresh
# the fleet audio-quality percentile gauges are at scrape time.
# AUDIO_QUALITY_SAMPLE_INTERVAL_MS=15000  # 15s default

# ==============================================================================
# GIFT BUFFER
# ==============================================================================
# GIFT_BUFFER_FLUSH_INTERVAL_MS=500  # 500ms default
# GIFT_MAX_RETRIES=3                 # 3 retries default

# ==============================================================================
# SEATS
# ==============================================================================
# DEFAULT_SEAT_COUNT=15  # 15 seats default (rooms select 5–20; this is the fallback)
# UI_ACTIVE_SPEAKER_HIGHLIGHT_COUNT=6  # UI "talking" indicators only — does NOT cap audio

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=replace-me-with-a-32-char-minimum-secret-key
JWT_MAX_AGE_SECONDS=86400

# ==============================================================================
# LARAVEL API
# ==============================================================================
LARAVEL_API_TIMEOUT_MS=30000

# ==============================================================================
# RATE LIMITING (message, reactions, typing)
# ==============================================================================
# RATE_LIMIT_MESSAGES_PER_MINUTE=60
# RATE_LIMIT_SEAT_REACTIONS_PER_WINDOW=1
# RATE_LIMIT_SEAT_REACTIONS_WINDOW_SECONDS=1.5
# RATE_LIMIT_TYPING_PER_WINDOW=1
# RATE_LIMIT_TYPING_WINDOW_SECONDS=2
# RATE_LIMIT_FAIL_OPEN=false

# ==============================================================================
# SEAT MANAGEMENT
# ==============================================================================
# MAX_SEAT_COUNT=30
# DEFAULT_SEAT_COUNT=15
# MAX_ROOMS_PER_WORKER=100
# MAX_LISTENERS_PER_DISTRIBUTION_ROUTER=700
# UI_ACTIVE_SPEAKER_HIGHLIGHT_COUNT=6

# ==============================================================================
# ROOM LIFECYCLE & PRESENCE
# ==============================================================================
# ROOM_PRESENCE_GRACE_MS=15000
# SEAT_RETENTION_GRACE_MS=45000
# ROOM_STATUS_COALESCE_WINDOW_MS=3000

# ==============================================================================
# BROADCAST TIER (interactive ↔ broadcast hysteresis)
# ==============================================================================
# ROOM_BROADCAST_THRESHOLD_UP=1500
# ROOM_BROADCAST_THRESHOLD_DOWN=1000
# ROOM_BROADCAST_DEMOTE_GRACE_MS=30000

# ==============================================================================
# GIFT BUFFERING
# ==============================================================================
# GIFT_BUFFER_FLUSH_INTERVAL_MS=500
# GIFT_MAX_RETRIES=5
# GIFT_RATE_LIMIT=330
# GIFT_RATE_WINDOW=60

# ==============================================================================
# DM PRESENCE (per-user connection tracking)
# ==============================================================================
# PRESENCE_TTL_SECONDS=75
# PRESENCE_SWEEP_INTERVAL_MS=30000
# PRESENCE_SUBSCRIBE_MAX=50

# ==============================================================================
# AUDIO QUALITY SAMPLER (observability-audio-quality 01)
# ==============================================================================
# Scores are pushed by the SFU as they change, so this only affects how fresh
# the fleet audio-quality percentile gauges are at scrape time.
# AUDIO_QUALITY_SAMPLE_INTERVAL_MS=15000  # 15s default

# ==============================================================================
# SENTRY ERROR TRACKING
# ==============================================================================
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_RELEASE=sha-<commit8>
# SENTRY_ENVIRONMENT=production
# SENTRY_FLUSH_MS=2000
# SENTRY_CLOSE_MS=2000
# CRASH_FLUSH_CAP_MS=2500
# CRASH_HARD_DEADLINE_MS=10000
# SENTRY_BUCKET_CAPACITY=20
# SENTRY_BUCKET_REFILL_HOUR=30

# ==============================================================================
# AWS REGION (for cross-region routing)
# ==============================================================================
# AWS_REGION=ap-south-1

# ==============================================================================
# SFU CASCADE (multi-instance relay)
# ==============================================================================
# CASCADE_THRESHOLD=1800
# INTERNAL_API_KEY=  # Required if CASCADE_ENABLED=true
# PUBLIC_IP=  # Required if CASCADE_ENABLED=true

# ==============================================================================
# REDIS ADVANCED
# ==============================================================================
# REDIS_USERNAME=default  # Only if using Valkey with ACL
# REDIS_TLS=false
# REDIS_TLS_CA_PATH=/path/to/ca-bundle.pem

# ==============================================================================
# LL-HLS BROADCAST TIER (realtime-09)
# ==============================================================================
# Requires all HLS_R2_* fields + HLS_PUBLIC_BASE_URL when BROADCAST_HLS_ENABLED=true
# BROADCAST_HLS_ENABLED=false
# HLS_FFMPEG_PATH=ffmpeg
# HLS_WORK_DIR=/tmp/flylive-hls
# HLS_SEGMENT_DURATION_SEC=1
# HLS_PLAYLIST_SIZE=6
# HLS_RESTART_DEBOUNCE_MS=1500

# ==============================================================================
# DEPLOYMENT
# AWS deployment is managed via Terraform + GitHub Actions.
# No local deployment secrets needed — AWS uses IAM instance profiles.
# ==============================================================================