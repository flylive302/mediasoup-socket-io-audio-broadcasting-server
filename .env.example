# =============================================================================
# FlyLive Audio Server - Environment Variables
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 🔧 APPLICATION SETTINGS (for local development)
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3030
LOG_LEVEL=debug

# Redis/Valkey (local development)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3

# JWT Authentication (shared secret with Laravel — MUST match MSAB_JWT_SECRET in Laravel .env)
JWT_SECRET=replace-me-with-a-32-char-minimum-secret-key
# JWT_MAX_AGE_SECONDS=2592000  # 30 days default (fallback if JWT has no exp claim)

# Laravel Integration
LARAVEL_API_URL=http://localhost:8000
LARAVEL_INTERNAL_KEY=replace-me-with-a-32-char-minimum-internal-key
# LARAVEL_API_TIMEOUT_MS=10000  # 10 seconds default

# ─── Secret-rotation overlap (leave UNSET outside a rotation) ────────────────
# During a two-sided rotation the two services cannot flip at the same instant
# (Laravel = console edit; MSAB = ~35min drain-gated fleet roll). These make the
# verifier accept the OUTGOING secret alongside the current one, so nothing is
# rejected in the gap. Comma-separated.
# UNSET THEM once the rotation completes — while set, the old secret is still
# valid, so the rotation has not actually closed the exposure.
# Procedure: docs/issues/secrets-repo-cleanup/01b-coordinated-rotation-runbook.md
# JWT_SECRET_PREVIOUS=
# LARAVEL_INTERNAL_KEY_PREVIOUS=
# INTERNAL_API_KEY_PREVIOUS=

# SSL Certificates (for local HTTPS/WSS development)
SSL_KEY_PATH=./localhost+2-key.pem
SSL_CERT_PATH=./localhost+2.pem

# MediaSoup
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# MEDIASOUP_NUM_WORKERS=2  # Optional: defaults to CPU count

# CORS (Your frontend domains)
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# 🆕 NEW CONFIGURATION OPTIONS
# -----------------------------------------------------------------------------

# Room Auto-Close (inactivity timer)
# ROOM_INACTIVITY_TIMEOUT_MS=300000      # 5 minutes default
# ROOM_AUTO_CLOSE_POLL_INTERVAL_MS=30000 # 30 seconds default

# Gift Buffer
# GIFT_BUFFER_FLUSH_INTERVAL_MS=500  # 500ms default
# GIFT_MAX_RETRIES=3                 # 3 retries default

# Seats
# DEFAULT_SEAT_COUNT=15  # 15 seats default (rooms select 5–20; this is the fallback)

# Active-speaker highlight (UI only — does NOT cap audio; all Speakers stay audible)
# UI_ACTIVE_SPEAKER_HIGHLIGHT_COUNT=6  # max simultaneous "talking" indicators shown

# JWT Configuration
# JWT_MAX_AGE_SECONDS=86400  # 24 hours (fallback if JWT has no exp claim)

# Redis Advanced
# REDIS_USERNAME=default
# REDIS_TLS=false  # Enable if using TLS
# REDIS_TLS_CA_PATH=/path/to/ca-bundle.pem  # Path to CA bundle for TLS verification

# MediaSoup Advanced
# MEDIASOUP_RTC_MIN_PORT=10000
# MEDIASOUP_RTC_MAX_PORT=59999

# Seat Management
# MAX_SEAT_COUNT=30  # Maximum seats a room can have
# DEFAULT_SEAT_COUNT=15  # Default seat count for new rooms
# MAX_ROOMS_PER_WORKER=100
# MAX_LISTENERS_PER_DISTRIBUTION_ROUTER=700

# Rate Limiting (message, reactions, typing indicators)
# RATE_LIMIT_MESSAGES_PER_MINUTE=60
# RATE_LIMIT_SEAT_REACTIONS_PER_WINDOW=1
# RATE_LIMIT_SEAT_REACTIONS_WINDOW_SECONDS=1.5
# RATE_LIMIT_TYPING_PER_WINDOW=1
# RATE_LIMIT_TYPING_WINDOW_SECONDS=2
# RATE_LIMIT_FAIL_OPEN=false  # fail-open on Redis error (true) vs fail-closed (false)

# Room Lifecycle & Presence
# ROOM_INACTIVITY_TIMEOUT_MS=120000  # 2 minutes before auto-close
# ROOM_AUTO_CLOSE_POLL_INTERVAL_MS=30000
# ROOM_PRESENCE_GRACE_MS=15000  # Debounce for empty-room detection
# SEAT_RETENTION_GRACE_MS=45000  # Hold disconnected Speaker seat this long
# ROOM_STATUS_COALESCE_WINDOW_MS=3000  # Batch room status updates

# Broadcast Tier (realtime-08: interactive ↔ broadcast threshold)
# ROOM_BROADCAST_THRESHOLD_UP=1500  # Listeners before promoting to broadcast
# ROOM_BROADCAST_THRESHOLD_DOWN=1000  # Listeners before demoting to interactive
# ROOM_BROADCAST_DEMOTE_GRACE_MS=30000  # Hold demote condition this long before acting

# Gift Buffering
# GIFT_BUFFER_FLUSH_INTERVAL_MS=500
# GIFT_MAX_RETRIES=5
# GIFT_RATE_LIMIT=330
# GIFT_RATE_WINDOW=60

# DM Presence (per-user connection tracking)
# PRESENCE_TTL_SECONDS=75
# PRESENCE_SWEEP_INTERVAL_MS=30000
# PRESENCE_SUBSCRIBE_MAX=50

# Sentry Error Tracking
# SENTRY_DSN=https://...@sentry.io/...  # Optional; telemetry must never take audio down
# SENTRY_RELEASE=sha-<commit8>  # Must match image-build sourcemap upload
# SENTRY_ENVIRONMENT=development
# SENTRY_FLUSH_MS=2000  # Crash-path timeout before forced exit
# SENTRY_CLOSE_MS=2000
# CRASH_FLUSH_CAP_MS=2500  # Buffer flush cap on crash path
# CRASH_HARD_DEADLINE_MS=10000  # Hard exit deadline on crash
# SENTRY_BUCKET_CAPACITY=20  # Client-side quota (burst)
# SENTRY_BUCKET_REFILL_HOUR=30  # Client-side quota (sustained/hour)

# WebRTC NAT Traversal (STUN/TURN)
# ICE_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.cloudflare.com:53
# CLOUDFLARE_TURN_API_KEY=  # Bearer token from Cloudflare Dashboard
# CLOUDFLARE_TURN_KEY_ID=  # Key ID from Cloudflare Dashboard

# AWS Region (for cross-region room routing / SFU cascade)
# AWS_REGION=ap-south-1

# SFU Cascade (Phase 5 — multi-instance edge relay)
# CASCADE_ENABLED=false
# CASCADE_THRESHOLD=1800  # Listeners before spawning edge instance
# INTERNAL_API_KEY=  # Shared secret for instance-to-instance auth
# PUBLIC_IP=  # This instance's public IP (from IMDS or env)

# LL-HLS Broadcast Tier (realtime-09)
# BROADCAST_HLS_ENABLED=false  # Requires HLS_R2_* and HLS_PUBLIC_BASE_URL when enabled
# HLS_R2_ENDPOINT=https://<acct>.r2.cloudflarestorage.com
# HLS_R2_ACCESS_KEY_ID=
# HLS_R2_SECRET_ACCESS_KEY=
# HLS_R2_BUCKET=flylive-live-hls
# HLS_PUBLIC_BASE_URL=https://live.example.com  # No trailing slash
# HLS_FFMPEG_PATH=ffmpeg
# HLS_WORK_DIR=/tmp/flylive-hls
# HLS_SEGMENT_DURATION_SEC=1  # ~1s segments for low-latency
# HLS_PLAYLIST_SIZE=6  # Manifest playlist size
# HLS_RESTART_DEBOUNCE_MS=1500  # Debounce FFmpeg restarts on topology changes