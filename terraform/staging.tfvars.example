# =============================================================================
# FlyLive Audio — STAGING var file (template)
# =============================================================================
# Usage:
#   cp staging.tfvars.example staging.tfvars   # then fill in the secrets
#   AWS_PROFILE=flylive-staging terraform plan  -var-file=staging.tfvars -out=tfplan
#   AWS_PROFILE=flylive-staging terraform apply tfplan
#
# staging.tfvars is gitignored (contains secrets). This .example is committed.
# Secrets must EQUAL the staging Laravel Cloud env vars (see docs/ops/deployment-migration-runbook.md §3):
#   laravel_internal_key  == Laravel MSAB_INTERNAL_KEY (staging)
#   jwt_secret            == Laravel MSAB_JWT_SECRET   (staging)
# =============================================================================

# --- Environment-specific (non-secret) ---
environment     = "staging"
audio_domain    = "audio.staging.flyliveapp.com"
# cors_origins = the browser ORIGIN that opens the audio socket = the FRONTEND host
# (src/auth/middleware.ts allowlists Origin; prod mirrors apex + app.). NOT the backend alone.
cors_origins    = "https://staging.flyliveapp.com,https://app.staging.flyliveapp.com"
laravel_api_url = "https://app.staging.flyliveapp.com"  # MSAB→Laravel internal calls (backend host)

ssh_public_key_path = "~/.ssh/flylive_deploy.pub"

# --- Cost lever (per-region) ---
# Full replica = 2 (matches prod). To cut cost between test cycles, drop to 1
# (or 0) and re-apply — keeps the GA/NLB/ACM stack intact so the next push to
# `staging` still auto-deploys (terraform destroy would break deploy.yml).
# Fixed-size fleet (ticket 18): one number → ASG min = max = desired.
fleet_size = 2

# Pinned image tag (ticket 14). Never "latest" — required, no default.
image_tag = "sha-CHANGE_ME"

# --- Secrets (generate with: openssl rand -hex 32) ---
jwt_secret           = "CHANGE_ME_64_hex"
laravel_internal_key = "CHANGE_ME_64_hex"
session_secret       = "CHANGE_ME_64_hex"
redis_auth_token     = "CHANGE_ME_16_to_128_chars_no_@_/_or_quotes"

# --- Rotation overlap (uncomment only while a rotation is in flight; secrets-repo-cleanup ticket 03) ---
# jwt_secret_previous            = "CHANGE_ME_outgoing_jwt_secret"
# laravel_internal_key_previous  = "CHANGE_ME_outgoing_laravel_internal_key"
# internal_api_key_previous      = "CHANGE_ME_outgoing_internal_api_key"

# --- internal_api_key split (uncomment to give instance↔instance cascade calls a key distinct from laravel_internal_key; ticket 03) ---
# internal_api_key = "CHANGE_ME_64_hex"

# --- Cloudflare Realtime TURN (staging key from Cloudflare dashboard) ---
cloudflare_turn_api_key = "CHANGE_ME"
cloudflare_turn_key_id  = "CHANGE_ME"

# --- Cloudflare DNS zone (unattended ACM validation — needs DNS Read + DNS Write on the zone) ---
cloudflare_api_token = "CHANGE_ME"
cloudflare_zone_id   = "CHANGE_ME"

# --- Alerting (ticket 32) ---
# Empty = alerting ships INERT (topic exists, nobody subscribed). Set to the
# on-call inbox to start receiving alarm notifications; requires clicking the
# SNS confirmation email that arrives after apply.
alert_email = ""

# Ticket 12: staging runs may only assume the staging deploy role
github_deploy_environment = "aws-staging"

# --- Redis bare-min profile (aws-production/01) ---
# Staging does NOT run production's HA topology: 4 × cache.r7g.large is ~$654/mo
# (78% of the staging bill) to support one idle test box, and Redis failover
# tests nothing on the path staging exists to measure (ticket 10's saturation
# curve). Estimated ~$39/mo for both stores in ap-south-1.
# ⚠️ Single node = an eviction or restart loses staging Redis state. Accepted.
redis_node_type          = "cache.t4g.micro"
redis_num_cache_clusters = 1
redis_automatic_failover = false
redis_multi_az           = false

# Durable store keeps noeviction + snapshots (aws-platform-build/21), just on one
# small node. t4g.small (1.37 GiB) not micro — it holds the money queue.
redis_durable_node_type          = "cache.t4g.small"
redis_durable_num_cache_clusters = 1
redis_durable_automatic_failover = false
redis_durable_multi_az           = false

# --- Load generator (aws-production/08) ---
# Ships INERT. Flipping loadgen_enabled to true is what stands up the box
# (docs/runbooks/msab-loadgen-campaign.md step 1) — everything else here is a
# safe-to-commit default. loadgen_harness_s3_uri can stay empty; the runbook's
# step 4 delivers the harness by hand when it is.
loadgen_enabled        = false
loadgen_instance_type  = "c7i.2xlarge"
loadgen_harness_s3_uri = ""
