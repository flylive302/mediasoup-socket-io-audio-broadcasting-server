# =============================================================================
# Terraform S3 Backend — production environment (ADR 0028: key-per-environment)
# =============================================================================
# Normally generated by scripts/aws/bootstrap-state.sh — prefer running that.
# Manual path:
#   1. cp backend-production.hcl.example backend-production.hcl
#   2. Fill in the AWS account ID (aws sts get-caller-identity)
#   3. terraform init -reconfigure -backend-config=backend-production.hcl
#
# backend-*.hcl is gitignored — never commit it (contains the account ID).
# Staging is identical except key = "env/staging/terraform.tfstate"
# (see backend-staging.hcl.example). Staging and production must NEVER
# share a state key.
# =============================================================================

bucket = "flylive-audio-tfstate-YOUR_ACCOUNT_ID_HERE"
key    = "env/production/terraform.tfstate"
